DirectoryIndex login.html

RewriteEngine On

# --- páginas amigáveis: /painel.html -> backend/painel.php ------------------
RewriteRule ^login\.html$       backend/login.php       [L]
RewriteRule ^cadastro\.html$    backend/register.php    [L]
RewriteRule ^painel\.html$      backend/painel.php      [L]
RewriteRule ^equipe\.html$      backend/equipe.php      [L]
RewriteRule ^calendario\.html$  backend/calendario.php  [L]
RewriteRule ^config\.html$      backend/config.php      [L]
RewriteRule ^alertas\.html$     backend/alertas.php     [L]
RewriteRule ^relatorio\.html$   backend/relatorio.php   [L]

# --- migração do banco (protegida por ?chave= no próprio PHP) --------------
RewriteRule ^migrar\.html$     backend/migrar.php      [L]

# --- raiz: entra no painel (o PHP manda para o login se não houver sessão) --
RewriteRule ^$ backend/painel.php [L]

# --- nada de listar diretórios ---------------------------------------------
Options -Indexes

# --- cabeçalhos de segurança ------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --- cache dos assets estáticos --------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml          "access plus 30 days"
</IfModule>
